# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Validated by src/env.ts when the app boots.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/riff_market
SESSION_SECRET=replace-me-with-a-secret-at-least-32-chars

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Optional
# SERVER_URL=http://localhost:3000
# NODE_ENV=development
# VITE_BASE_API=

# Used by DB-backed Vitest tests and Playwright (not in src/env.ts).
# Database name must contain: test | testing | vitest | integration
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/riff_market_test
