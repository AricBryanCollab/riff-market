// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  CUSTOMER
}

enum ProductCategory {
  ELECTRIC
  ACOUSTIC
  KEYBOARD
  PEDALS
  ACCESSORY
}

enum ProductCondtion {
  NEW
  USED
  MINT
}

enum PaymentMethod {
  CASH
  PAYPAL
  VISA
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PurchaseStatus {
  OPEN
  CANCELED
  COMPLETED
}

enum PaymentStatus {
  MANUALLY_CONFIRMED
  PENDING_PAYMENT
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum SellerOrderStatus {
  ON_HOLD_PAYMENT
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum ListingStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

enum ChatRole {
  USER
  ASSISTANT
}

enum MediaCleanupJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum MediaCleanupJobSourceType {
  USER_PROFILE
  PRODUCT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  role      Role     @default(CUSTOMER)

  settings      UserSettings?
  products       Product[]
  orders        Order[]
  purchases     Purchase[]
  sellerOrders  SellerOrder[]
  reviews       Review[]
  notifications Notification[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id        String @id @default(uuid())
  userId    String @unique

  theme      String
  phone      String?
  address    String?
  profilePic Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id Int @id @default(1)
  currency String @default("USD")
  updatedAt DateTime @updatedAt
}

model Order {
  id               String @id @default(uuid())
  userId           String
  orderDate        DateTime
  totalAmount      Float
  shippingAddress  String
  paymentMethod    PaymentMethod
  trackingNumber   String
  status OrderStatus @default(PENDING)

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  notifications Notification[]

  @@index([userId])
  @@index([orderDate])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId  String
  productId String

  quantity  Int
  unitPrice Float
  subTotal  Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Purchase {
  id               String @id @default(uuid())
  customerId         String?
  customerIdSnapshot String
  purchaseNumber     String @unique
  totalAmountCents   Int
  currencyCode       String @default("USD")
  paymentStatus      PaymentStatus @default(MANUALLY_CONFIRMED)
  status             PurchaseStatus @default(OPEN)
  buyerName          String
  buyerEmail         String
  buyerPhone         String?
  shippingAddress    String

  customer      User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerOrders  SellerOrder[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerIdSnapshot])
  @@index([createdAt])
}

model SellerOrder {
  id               String @id @default(uuid())
  purchaseId       String
  sellerId         String?
  sellerIdSnapshot String
  subtotalCents    Int
  currencyCode     String @default("USD")
  status           SellerOrderStatus @default(NEW)
  trackingNumber   String?

  purchase      Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  seller        User?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items         SellerOrderItem[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([sellerId])
  @@index([sellerIdSnapshot])
  @@index([status])
  @@index([createdAt])
}

model SellerOrderItem {
  id                String @id @default(uuid())
  sellerOrderId     String
  listingId         String
  listingName       String
  brand             String
  model             String
  category          String
  condition         String
  primaryImageUrl   String
  sellerId          String
  sellerDisplayName String
  unitPriceCents    Int
  quantity          Int
  subTotalCents     Int
  currencyCode      String @default("USD")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sellerOrderId])
  @@index([listingId])
  @@index([sellerId])
}

model Product {
  id          String @id @default(uuid())
  sellerId    String
  name        String
  category    ProductCategory
  condition   ProductCondtion
  brand       String
  model       String
  images      Json
  description String
  price       Float
  priceCents  Int?
  currencyCode String @default("USD")
  stock       Int
  isApproved Boolean
  listingStatus ListingStatus @default(PENDING)
  favoritedBy Favorite[]

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([category])
  @@index([isApproved])
  @@index([listingStatus])
}

model ChatBotSession {
  id        String @id @default(uuid())
  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id        String @id @default(uuid())
  sessionId String
  role ChatRole
  content   String

  session ChatBotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Review {
  id        String @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@unique([userId, productId]) 
  @@index([productId])
  @@index([userId])
}

model Favorite {
  id String @id @default(uuid())
  userId String
  productId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Notification {
  id      String @id @default(uuid())
  userId  String
  orderId String?
  purchaseId String?
  sellerOrderId String?
  message String
  isRead  Boolean @default(false)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([purchaseId])
  @@index([sellerOrderId])
}

model MediaCleanupJob {
  id           String                    @id @default(uuid())
  cleanupBatchId String
  provider     String
  assetType    String
  providerAssetId String
  sourceType   MediaCleanupJobSourceType
  sourceId     String
  sourceUserId String
  status       MediaCleanupJobStatus     @default(PENDING)
  attempts     Int                       @default(0)
  maxAttempts  Int                       @default(5)
  runAt        DateTime                  @default(now())
  lockedUntil  DateTime?
  lockedBy     String?
  completedAt  DateTime?
  failedAt     DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cleanupBatchId, provider, assetType, providerAssetId])
  @@index([status, runAt, createdAt, id])
  @@index([status, lockedUntil])
  @@index([cleanupBatchId])
  @@index([sourceUserId])
}
